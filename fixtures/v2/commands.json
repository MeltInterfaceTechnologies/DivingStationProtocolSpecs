    {
      "id": "profile-found",
      "spec": "ds_protocol_v2_EN.md#retarget-profile-information-request",
      "message": {
        "address": "/DS2/HC/HandSkeleton/Profile/Get",
        "types": "iis",
        "args": [
          2,
          -2147483648,
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "expected": {
        "outcome": "profile",
        "emissions": [
          {
            "target": [
              "127.0.0.1",
              42000
            ],
            "message": {
              "address": "/DS2/HC/HandSkeleton/Profile",
              "types": "iisiss",
              "args": [
                2,
                -2147483648,
                "00000000-0000-4000-8000-000000000001",
                0,
                "Mock left",
                "Synthetic left profile; no retargeting."
              ]
            }
          }
        ],
        "haptics": []
      }
    },
